10 CLEAR
20 PRINT "=== REAL-TIME LANDER ==="
30 PRINT "GRAVITY IS ACTIVE! HOLD 8 TO THRUST"
40 PRINT "--------------------------"
50 X = 160
60 Y = 20
70 V = 0
80 G = 1
90 F = 100
100 P = 140
110 L = 40
120 H = 200
130 RECT P, H, L, 4, 2
140 CIRCLE X, Y, 4, 1
150 INKEY K
160 CIRCLE X, Y, 4, 0
170 IF K == 56 GOTO 200
180 V = V + G
190 GOTO 220
200 V = V - 2
210 F = F - 1
220 Y = Y + V
230 IF F <= 0 GOTO 245
235 IF K != 56 GOTO 245
240 BEEP 400, 10
245 DELAY 50
250 IF Y < H GOTO 140
260 RECT P, H, L, 4, 2
270 CIRCLE X, H, 4, 1
280 IF X < P GOTO 350
290 M = P + L
300 IF X > M GOTO 350
310 IF V > 4 GOTO 350
320 BEEP 1000, 100
330 PRINT "SUCCESSFUL LANDING!"
340 GOTO 380
350 BEEP 150, 400
360 RECT X - 10, H - 10, 20, 20, 1
370 PRINT "CRASHED! SPEED TOO HIGH."
380 KEY "PLAY AGAIN? (1=YES)", A
390 IF A == 1 GOTO 10
